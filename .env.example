# 复制为 .env.local 后填写（勿将 .env.local 提交到 Git）

# 统一后端根（无尾斜杠）；专项 / 课堂 / 报告 / 文档上传与分析均以此为前缀
# VITE_BACKEND_BASE_URL=http://127.0.0.1:8787
# 与站点同源反代时可设为 /api
# VITE_BACKEND_BASE_URL=/api

# VITE_BACKEND_API_KEY=

# 默认 JSON 单次响应；需要 SSE 时设为 false
# VITE_BACKEND_USE_JSON_RESPONSE=false

# 路径覆盖（可选，默认见 docs/BACKEND_INTEGRATION_SPEC.md）
# VITE_BACKEND_PATH_SPECIAL=/simu/special/chat
# VITE_BACKEND_PATH_CLASSROOM=/simu/classroom/chat
# VITE_BACKEND_PATH_REPORT=/simu/report
# VITE_BACKEND_PATH_DOC=/simu/doc/chat
# VITE_BACKEND_PATH_DOC_UPLOAD=/simu/doc/upload
# （可选）预签名上传等特殊部署：storage-credential、cos-upload
# VITE_BACKEND_PATH_DOC_STORAGE=/simu/doc/storage-credential
# VITE_BACKEND_PATH_DOC_COS_PROXY=/simu/doc/cos-upload
# 一步上传并分析（默认）：POST {BASE}/simu/doc/analyze  multipart 字段 file
# VITE_BACKEND_PATH_DOC_ANALYZE=/simu/doc/analyze
# 改回两步（先 upload 再 chat）：VITE_BACKEND_DOC_SINGLE_STEP=false

# ===== 教学文档分析（无需凭证）=====
# 默认一步：见 BACKEND_INTEGRATION_SPEC.md §5.1
# 两步时：§5.2 上传 + §5.3 分析；自定义上传 URL：VITE_DOC_FILE_UPLOAD_URL=https://...

# ===== 本地开发：报告走 /api/report 时需配置上游（否则勿依赖该路径）=====
# VITE_REPORT_PROXY_TARGET=https://your-report-host.example
