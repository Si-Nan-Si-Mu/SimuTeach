# 复制为 .env.local 后填写（勿将 .env.local 提交到 Git）

# ===== 部署（生产构建 npm run build）=====
# 解决「Failed to resolve module specifier vue」：必须部署 dist 目录，不要直接把含 src/ 的源码当静态站。
# 构建命令：npm ci && npm run build，再把 dist/ 内全部文件上传为站点根或子目录。
# 静态资源 base 在 vite.config.js 中为 ./；若必须固定绝对子路径，请改 vite.config.js 的 base。

# ===== 专项模拟（主对话）=====
VITE_SPECIAL_BOT_APP_KEY=
VITE_SPECIAL_WORKFLOW_DEBUG=true
# false = 工作流无返回时不使用本地模拟学生回复；工作流返回的正文仍会正常显示
VITE_SPECIAL_AUTO_APPEND_REPLY=true
# VITE_SPECIAL_VISITOR_BIZ_ID=teacher-001
# VITE_SPECIAL_PROXY_URL=http://127.0.0.1:8787/lke/sse
# VITE_SPECIAL_ENDPOINT=https://wss.lke.cloud.tencent.com/v1/qbot/chat/sse

# ===== 训练报告（直连 HTTP，不再走腾讯云 SSE）=====
# 浏览器实际请求的地址。开发时若填 https 外域会触发 CORS，已自动改为走 /api/report 代理，此项在 dev 下可省略
# VITE_REPORT_HTTP_URL=/api/report
# 代理目标（仅 Vite dev / vite preview）：/api/report 转发到 目标主机 + 下方路径
# VITE_REPORT_PROXY_TARGET=https://agent.orangeblog.us.kg
# 上游路径；默认 /v1/chat/completions
# VITE_REPORT_PROXY_PATH=/v1/chat/completions
# 生产构建若仍直连外域且遇 CORS，请把站点根路径反代到该 API，并把 VITE_REPORT_HTTP_URL 设为同源路径
# 直连后端完整地址（含路径）；不设时生产默认 https://agent.orangeblog.us.kg/v1/chat/completions
# VITE_REPORT_HTTP_URL=https://agent.orangeblog.us.kg/v1/chat/completions
# 必填；会打进前端包，浏览器可见，生产建议由自有后端代发
# 报告请求为 POST：Chat Completions 形；仅标准字段，不含对话/情绪等训练数据
# 请求头 Authorization: Bearer；JSON 内可含 api_key（见 workflow.js）
# VITE_REPORT_HTTP_API_KEY=
# 报告里 user 消息的固定文案（默认：请生成教学训练报告。）
# VITE_REPORT_USER_MESSAGE=
# 可选：覆盖 model（否则用当前学生名，再默认「李大志」）
# VITE_REPORT_CHAT_MODEL=李大志
# VITE_REPORT_CHAT_TEMPERATURE=0.8
# VITE_REPORT_CHAT_TOP_P=0.95
# VITE_REPORT_CHAT_MAX_TOKENS=512
# VITE_REPORT_CHAT_STREAM=false
# VITE_REPORT_CHAT_USER=teacher_session_1
# VITE_REPORT_WORKFLOW_DEBUG=true
#
# （旧）训练报告独立 Bot，已不使用时可留空
# VITE_REPORT_BOT_APP_KEY=
# VITE_REPORT_VISITOR_BIZ_ID=teacher-001
# VITE_REPORT_PROXY_URL=http://127.0.0.1:8787/lke/sse
# VITE_REPORT_ENDPOINT=https://wss.lke.cloud.tencent.com/v1/qbot/chat/sse

# ===== 课堂模拟（独立 Bot）=====
VITE_CLASSROOM_BOT_APP_KEY=
VITE_CLASSROOM_WORKFLOW_DEBUG=true
# VITE_CLASSROOM_VISITOR_BIZ_ID=classroom_teacher_001
# VITE_CLASSROOM_PROXY_URL=http://127.0.0.1:8787/lke/sse
# VITE_CLASSROOM_ENDPOINT=https://wss.lke.cloud.tencent.com/v1/qbot/chat/sse

# ===== 教学文档分析（文件输入）=====
# 流程：先上传得到 file_url，再 POST JSON；默认走 qbot SSE（与课堂模拟同一类接口）
# 教学文档分析专用：上传后调 qbot SSE 时请求体里的 bot_app_key（仅本页使用）。
# 已配置则优先于专项模拟的 VITE_SPECIAL_BOT_APP_KEY，勿把真实密钥提交到 Git，只写在 .env.local
VITE_DOC_BOT_APP_KEY=
# SSE 与专项模拟对齐：visitor / custom_variables（role、trigger、characterId、model）及可选「{模型名}」前缀
# VITE_DOC_VISITOR_BIZ_ID=teacher-001
# VITE_DOC_SSE_ROLE=teacher
# VITE_DOC_SSE_TRIGGER=互动
# VITE_DOC_SSE_CHARACTER_ID=dazhi
# VITE_DOC_SSE_MODEL_NAME=李大志
# 说明：文档分析 SSE 的 content/message 仅为文件 URL；模型名只影响 custom_variables / 顶层 model，不拼进正文
# VITE_DOC_WORKFLOW_STATUS=enable
# 可选：覆盖文档分析请求地址。不配时与专项模拟相同：用 window.WORKFLOW_CONFIG.endpoint，再回退官方 qbot SSE
# VITE_DOC_WORKFLOW_ENDPOINT=https://wss.lke.cloud.tencent.com/v1/qbot/chat/sse
# 纯 HTTP trigger（非 SSE）时可用；SSE 仍用 VITE_DOC_BOT_APP_KEY 放在请求体
# VITE_DOC_WORKFLOW_API_KEY=
# VITE_DOC_WORKFLOW_AUTHORIZATION=Bearer xxx
# 可选：ADP 凭证接口（DescribeStorageCredential）
# 默认走本地代理 /api/describe-storage-credential（见 vite.config.js）
# 若你已有后端接口，可改成外部地址
# VITE_DOC_STORAGE_CREDENTIAL_URL=/api/describe-storage-credential
# COS 预签名上传本地代理（用于规避浏览器 CORS）
# VITE_DOC_COS_UPLOAD_PROXY_URL=/api/cos-upload
# VITE_DOC_STORAGE_BOT_BIZ_ID=your-bot-biz-id
# 本地代理调用腾讯云 OpenAPI 所需凭据（仅本地 .env.local 配置，切勿提交）
# VITE_ADP_SECRET_ID=
# VITE_ADP_SECRET_KEY=
# VITE_ADP_REGION=ap-guangzhou
# VITE_ADP_OPENAPI_ENDPOINT=https://lke.tencentcloudapi.com
# 直连上传地址（接收 form-data file，返回 JSON 含 file_url/url）。若设置则跳过 DescribeStorageCredential，
# 此时请同时配置 VITE_DOC_WORKFLOW_ENDPOINT（因凭证里不会再带 workflow_url）
# VITE_DOC_FILE_UPLOAD_URL=https://your-upload-endpoint
# 可选：写入 custom_variables.workflow_entry（字符串），便于工作流开始节点区分入口
# VITE_DOC_WORKFLOW_ENTRY=
